{
  "schema_version": 1,
  "name": "acfun",
  "display_name": "AcFun",
  "default_enabled": false,
  "fields": {
    "use_proxy": {
      "type": "bool",
      "label": "使用代理",
      "default": false
    },
    "cookies": {
      "type": "text",
      "label": "Cookies",
      "hint": "选填，用于访问需要登录或限制访问的视频",
      "secret": true,
      "default": ""
    },
    "video_quality": {
      "type": "select",
      "label": "视频画质偏好",
      "hint": "auto 自动选择最高可用画质；也可指定 4k、1080p60、1080p、720p、540p、360p",
      "options": [
        "auto",
        "4k",
        "1080p60",
        "1080p",
        "720p",
        "540p",
        "360p"
      ],
      "default": "auto"
    }
  }
}
