{
  "schema_version": 1,
  "name": "jmcomic",
  "display_name": "jmcomic",
  "default_enabled": false,
  "fields": {
    "use_proxy": {
      "type": "bool",
      "label": "使用代理",
      "default": false
    },
    "cookies": {
      "type": "text",
      "label": "Cookies",
      "hint": "选填",
      "secret": true,
      "default": ""
    },
    "image_send_mode": {
      "type": "select",
      "label": "漫画发送方式",
      "options": [
        "merge",
        "pdf",
        "ignore"
      ],
      "default": "pdf"
    },
    "nsfw": {
      "type": "select",
      "label": "漫画封面处理方式",
      "options": [
        "send",
        "blur",
        "ignore"
      ],
      "default": "blur"
    },
    "max_page": {
      "type": "int",
      "label": "最大页数",
      "hint": "发送漫画时接受的最大页数，超过则跳过下载发送。0则不限制",
      "default": 50
    },
    "include_comments": {
      "type": "bool",
      "label": "卡片显示评论",
      "hint": "获取当前章节第一页的评论及一级回复",
      "default": true
    },
    "comment_limit": {
      "type": "int",
      "label": "评论数量",
      "hint": "单个章节最多获取的根评论数量，范围 0-20",
      "default": 5
    }
  }
}
