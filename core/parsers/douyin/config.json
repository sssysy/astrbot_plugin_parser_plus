{
  "schema_version": 1,
  "name": "douyin",
  "display_name": "抖音",
  "default_enabled": false,
  "fields": {
    "use_proxy": {
      "type": "bool",
      "label": "使用代理",
      "default": false
    },
    "cookies": {
      "type": "text",
      "label": "Cookies",
      "hint": "选填",
      "secret": true,
      "default": ""
    },
    "video_quality": {
      "type": "select",
      "label": "视频画质偏好",
      "hint": "auto 自动选择最高可用画质；也可指定 1080p、720p、540p",
      "options": [
        "auto",
        "1080p",
        "720p",
        "540p"
      ],
      "default": "auto"
    },
    "include_comments": {
      "type": "bool",
      "label": "卡片显示评论",
      "hint": "获取热门根评论、评论图片和表情",
      "default": false
    },
    "comment_limit": {
      "type": "int",
      "label": "评论数量",
      "hint": "单个作品最多获取的根评论数量，范围 0-20；关闭评论时无需请求",
      "default": 5
    }
  }
}
